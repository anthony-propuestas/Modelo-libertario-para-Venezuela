---
import Layout from '../layouts/Layout.astro';

const env = (Astro.locals as any).runtime?.env;

type Seccion = { id: number; nombre: string; order_index: number };
type Item = { id: number; seccion_id: number; nombre: string; valor: string; order_index: number };

let secciones: Seccion[] = [];
let items: Item[] = [];

try {
  if (env?.DB) {
    const secRes = await env.DB.prepare('SELECT * FROM datos_secciones ORDER BY order_index').all();
    secciones = secRes.results ?? [];
    if (secciones.length > 0) {
      const itemRes = await env.DB.prepare('SELECT * FROM datos_items ORDER BY seccion_id, order_index').all();
      items = itemRes.results ?? [];
    }
  }
} catch {}

function itemsPorSeccion(seccionId: number) {
  return items.filter(i => i.seccion_id === seccionId);
}
---
<Layout title="Datos">
  <div style="max-width:760px;margin:0 auto;padding:3rem 2rem;">
    <h1 style="font-size:2rem;font-weight:700;margin-bottom:0.5rem;font-family:'Helvetica Neue',Arial,sans-serif;">Datos sobre Venezuela</h1>
    <p style="color:var(--muted);margin-bottom:3rem;font-size:0.95rem;">Estadísticas y cifras registradas manualmente.</p>

    {secciones.length === 0 ? (
      <p style="color:var(--muted);">No hay datos disponibles aún.</p>
    ) : (
      secciones.map(sec => (
        <div style="margin-bottom:2.5rem;">
          <h2 style="font-size:1.1rem;font-weight:700;font-family:'Helvetica Neue',Arial,sans-serif;text-transform:uppercase;letter-spacing:0.04em;color:var(--amarillo);border-bottom:1px solid var(--border);padding-bottom:0.5rem;margin-bottom:1rem;">
            {sec.nombre}:
          </h2>
          {itemsPorSeccion(sec.id).length === 0 ? (
            <p style="color:var(--muted);font-size:0.9rem;">Sin ítems.</p>
          ) : (
            <dl style="display:grid;grid-template-columns:auto 1fr;gap:0.4rem 1.5rem;align-items:baseline;">
              {itemsPorSeccion(sec.id).map(item => (
                <>
                  <dt style="color:var(--muted);font-size:0.9rem;white-space:nowrap;">{item.nombre}:</dt>
                  <dd style="font-weight:500;">{item.valor}</dd>
                </>
              ))}
            </dl>
          )}
        </div>
      ))
    )}
  </div>
</Layout>
