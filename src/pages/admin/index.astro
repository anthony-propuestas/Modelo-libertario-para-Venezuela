---
import { validateSession } from '../../lib/auth';

const env = (Astro.locals as any).runtime?.env;
const valid = await validateSession(Astro.request.headers.get('cookie'), env?.ADMIN_SECRET);
if (valid) return Astro.redirect('/admin/dashboard');

const error = Astro.url.searchParams.get('error');
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin — Venezuela Liberal</title>
  <link rel="icon" href="/favicon.svg" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: #f4f4f5;
      font-family: 'Helvetica Neue', Arial, sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      color: #1a1a1a;
    }
    .card {
      background: #fff;
      border: 1px solid #e0e0e0;
      border-radius: 10px;
      padding: 2.5rem;
      width: 100%;
      max-width: 380px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    }
    .flag { height: 4px; background: linear-gradient(to right,#CF8A00 33.33%,#003DA5 33.33%,#003DA5 66.66%,#CF142B 66.66%); border-radius: 2px; margin-bottom: 1.5rem; }
    h1 { font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem; }
    label { display: block; font-size: 0.75rem; font-weight: 700; margin-bottom: 0.3rem; color: #666; text-transform: uppercase; letter-spacing: 0.06em; }
    input { width: 100%; padding: 0.6rem 0.75rem; border: 1px solid #ddd; border-radius: 5px; font-size: 0.95rem; margin-bottom: 1rem; font-family: inherit; }
    input:focus { outline: none; border-color: #003DA5; }
    button { width: 100%; padding: 0.65rem; background: #003DA5; color: #fff; border: none; border-radius: 5px; font-size: 0.95rem; font-weight: 600; cursor: pointer; font-family: inherit; }
    button:hover { background: #002d7a; }
    .error { background: #fff0f0; border: 1px solid #CF142B; color: #CF142B; border-radius: 5px; padding: 0.6rem 0.75rem; font-size: 0.875rem; margin-bottom: 1rem; }
  </style>
</head>
<body>
  <div class="card">
    <div class="flag"></div>
    <h1>Acceso Admin</h1>
    {error && <div class="error">Contraseña incorrecta.</div>}
    <form action="/api/auth/login" method="post">
      <div>
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" required autofocus placeholder="••••••••" />
      </div>
      <button type="submit">Entrar</button>
    </form>
  </div>
</body>
</html>
