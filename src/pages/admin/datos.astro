---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { validateSession } from '../../lib/auth';

const env = (Astro.locals as any).runtime?.env;
const valid = await validateSession(Astro.request.headers.get('cookie'), env?.ADMIN_SECRET);
if (!valid) return Astro.redirect('/admin');

type Seccion = { id: number; nombre: string; order_index: number };
type Item = { id: number; seccion_id: number; nombre: string; valor: string; order_index: number };

let secciones: Seccion[] = [];
let items: Item[] = [];
let dbError = '';
try {
  const secRes = await env.DB.prepare('SELECT * FROM datos_secciones ORDER BY order_index').all();
  secciones = secRes.results ?? [];
  const itemRes = await env.DB.prepare('SELECT * FROM datos_items ORDER BY seccion_id, order_index').all();
  items = itemRes.results ?? [];
} catch (e: any) {
  dbError = e?.message ?? 'Error de base de datos';
}

function itemsPorSeccion(seccionId: number) {
  return items.filter((i: Item) => i.seccion_id === seccionId);
}
---
<AdminLayout title="Datos — Admin">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;">
    <h1 style="font-size:1.3rem;font-weight:700;">Datos</h1>
  </div>

  {dbError && (
    <div style="background:#7f1d1d;color:#fca5a5;padding:1rem;border-radius:6px;margin-bottom:1.5rem;font-size:0.9rem;">
      Error de base de datos: {dbError}. Asegúrate de haber aplicado la migración con <code>wrangler d1 migrations apply liberal-venezuela-db --remote</code>.
    </div>
  )}

  <!-- Nueva sección -->
  <div class="card" style="margin-bottom:2rem;">
    <h2 style="font-size:0.8rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);margin-bottom:1rem;">Nueva sección</h2>
    <form id="form-nueva-seccion" style="display:flex;gap:0.75rem;align-items:flex-end;">
      <div class="field" style="flex:1;margin:0;">
        <label>Nombre de la sección</label>
        <input type="text" name="nombre" placeholder="Ej: Datos sociales" required />
      </div>
      <button type="submit" class="btn btn-primary">Crear sección</button>
    </form>
  </div>

  <!-- Lista de secciones -->
  <div id="secciones-lista">
    {secciones.map(sec => (
      <div class="card" id={`sec-${sec.id}`} style="margin-bottom:1.25rem;">
        <!-- Cabecera de sección -->
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
          <div style="display:flex;align-items:center;gap:0.75rem;flex:1;">
            <input
              type="text"
              value={sec.nombre}
              data-sec-id={sec.id}
              class="sec-nombre-input"
              style="font-weight:700;font-size:1rem;flex:1;"
            />
          </div>
          <div style="display:flex;gap:0.5rem;margin-left:1rem;">
            <button class="btn btn-primary btn-sm sec-guardar" data-sec-id={sec.id}>Guardar</button>
            <button class="btn btn-danger btn-sm sec-eliminar" data-sec-id={sec.id}>Eliminar sección</button>
          </div>
        </div>

        <hr />

        <!-- Items de esta sección -->
        <div id={`items-${sec.id}`} style="margin:0.75rem 0;">
          {itemsPorSeccion(sec.id).map(item => (
            <div class="item-row" id={`item-${item.id}`} style="display:grid;grid-template-columns:1fr 1fr auto auto;gap:0.5rem;align-items:center;margin-bottom:0.5rem;">
              <input type="text" value={item.nombre} placeholder="Nombre del dato" class="item-nombre" data-item-id={item.id} />
              <input type="text" value={item.valor} placeholder="Valor" class="item-valor" data-item-id={item.id} />
              <button class="btn btn-primary btn-sm item-guardar" data-item-id={item.id}>Guardar</button>
              <button class="btn btn-danger btn-sm item-eliminar" data-item-id={item.id}>✕</button>
            </div>
          ))}
        </div>

        <!-- Nuevo ítem -->
        <form class="form-nuevo-item" data-sec-id={sec.id} style="display:grid;grid-template-columns:1fr 1fr auto;gap:0.5rem;align-items:flex-end;margin-top:0.75rem;">
          <div class="field" style="margin:0;">
            <label>Nombre del dato</label>
            <input type="text" name="nombre" placeholder="Ej: Cantidad de personas" required />
          </div>
          <div class="field" style="margin:0;">
            <label>Valor</label>
            <input type="text" name="valor" placeholder="Ej: 32000000" required />
          </div>
          <button type="submit" class="btn btn-secondary btn-sm" style="margin-bottom:2px;">+ Agregar</button>
        </form>
      </div>
    ))}
  </div>

  {secciones.length === 0 && (
    <p style="color:var(--muted);text-align:center;padding:2rem;">No hay secciones. Crea una arriba.</p>
  )}
</AdminLayout>

<script>
  const toast = (window as any).showToast;

  // Crear nueva sección
  document.getElementById('form-nueva-seccion')!.addEventListener('submit', async e => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const nombre = (form.elements.namedItem('nombre') as HTMLInputElement).value.trim();
    const res = await fetch('/api/admin/datos-secciones', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ nombre }),
    });
    if (res.ok) {
      toast('Sección creada');
      location.reload();
    } else {
      toast('Error al crear sección', false);
    }
  });

  // Guardar nombre de sección
  document.querySelectorAll<HTMLButtonElement>('.sec-guardar').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.secId!;
      const input = document.querySelector<HTMLInputElement>(`.sec-nombre-input[data-sec-id="${id}"]`)!;
      const res = await fetch(`/api/admin/datos-secciones/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nombre: input.value }),
      });
      toast(res.ok ? 'Guardado' : 'Error', res.ok);
    });
  });

  // Eliminar sección
  document.querySelectorAll<HTMLButtonElement>('.sec-eliminar').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('¿Eliminar esta sección y todos sus datos?')) return;
      const id = btn.dataset.secId!;
      const res = await fetch(`/api/admin/datos-secciones/${id}`, { method: 'DELETE' });
      if (res.ok) {
        document.getElementById(`sec-${id}`)?.remove();
        toast('Sección eliminada');
      } else {
        toast('Error', false);
      }
    });
  });

  // Guardar ítem
  document.querySelectorAll<HTMLButtonElement>('.item-guardar').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.itemId!;
      const nombre = document.querySelector<HTMLInputElement>(`.item-nombre[data-item-id="${id}"]`)!.value;
      const valor = document.querySelector<HTMLInputElement>(`.item-valor[data-item-id="${id}"]`)!.value;
      const res = await fetch(`/api/admin/datos-items/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nombre, valor }),
      });
      toast(res.ok ? 'Guardado' : 'Error', res.ok);
    });
  });

  // Eliminar ítem
  document.querySelectorAll<HTMLButtonElement>('.item-eliminar').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.itemId!;
      const res = await fetch(`/api/admin/datos-items/${id}`, { method: 'DELETE' });
      if (res.ok) {
        document.getElementById(`item-${id}`)?.remove();
        toast('Eliminado');
      } else {
        toast('Error', false);
      }
    });
  });

  // Agregar nuevo ítem a sección
  document.querySelectorAll<HTMLFormElement>('.form-nuevo-item').forEach(form => {
    form.addEventListener('submit', async e => {
      e.preventDefault();
      const seccionId = Number(form.dataset.secId);
      const nombre = (form.elements.namedItem('nombre') as HTMLInputElement).value.trim();
      const valor = (form.elements.namedItem('valor') as HTMLInputElement).value.trim();
      const res = await fetch('/api/admin/datos-items', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ seccion_id: seccionId, nombre, valor }),
      });
      if (res.ok) {
        toast('Ítem agregado');
        location.reload();
      } else {
        toast('Error al agregar ítem', false);
      }
    });
  });
</script>
