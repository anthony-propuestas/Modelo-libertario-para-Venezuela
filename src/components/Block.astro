---
import { marked } from 'marked';

interface Props {
  block: {
    type: 'heading' | 'text' | 'image' | 'video' | 'table';
    content: string;
  };
}
const { block } = Astro.props;

function getEmbedUrl(url: string): string | null {
  const yt = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&\s?#]+)/);
  if (yt) return `https://www.youtube-nocookie.com/embed/${yt[1]}`;
  const vm = url.match(/vimeo\.com\/(\d+)/);
  if (vm) return `https://player.vimeo.com/video/${vm[1]}`;
  return null;
}

const embedUrl = block.type === 'video' ? getEmbedUrl(block.content) : null;
const htmlContent = block.type === 'text' ? String(marked.parse(block.content)) : '';

let tableData: { headers: string[]; rows: string[][] } = { headers: [], rows: [] };
if (block.type === 'table' && block.content) {
  try { tableData = JSON.parse(block.content); } catch {}
}
---

{block.type === 'heading' && (
  <h2 class="block-heading">{block.content}</h2>
)}

{block.type === 'text' && (
  <div class="prose" set:html={htmlContent} />
)}

{block.type === 'image' && block.content && (
  <figure class="block-image">
    <img src={`/api/image/${block.content}`} alt="" loading="lazy" />
  </figure>
)}

{block.type === 'video' && embedUrl && (
  <div class="block-video">
    <iframe
      src={embedUrl}
      allowfullscreen
      loading="lazy"
      title="Video"
    />
  </div>
)}

{block.type === 'video' && !embedUrl && block.content && (
  <p style="color:var(--muted);font-style:italic;font-size:0.875rem;">Video no disponible.</p>
)}

{block.type === 'table' && tableData.headers.length > 0 && (
  <div class="block-table">
    <table>
      <thead>
        <tr>{tableData.headers.map(h => <th>{h}</th>)}</tr>
      </thead>
      <tbody>
        {tableData.rows.map(row => (
          <tr>{row.map(cell => <td>{cell}</td>)}</tr>
        ))}
      </tbody>
    </table>
  </div>
)}

<style>
  .block-heading {
    font-size: 1.45rem;
    color: var(--amarillo);
    margin: 2rem 0 0.6rem;
    font-family: 'Georgia', serif;
    line-height: 1.3;
  }
  .prose { margin: 0.75rem 0; }
  .prose :global(h1), .prose :global(h2), .prose :global(h3) { margin: 1.5rem 0 0.5rem; line-height: 1.3; }
  .prose :global(p) { margin-bottom: 1rem; }
  .prose :global(p:last-child) { margin-bottom: 0; }
  .prose :global(ul), .prose :global(ol) { margin: 0.75rem 0 1rem 1.5rem; }
  .prose :global(li) { margin-bottom: 0.3rem; }
  .prose :global(blockquote) {
    border-left: 3px solid var(--amarillo);
    padding-left: 1rem;
    margin: 1.25rem 0;
    color: var(--muted);
    font-style: italic;
  }
  .prose :global(a) { color: var(--azul); }
  .prose :global(strong) { font-weight: 700; }
  .prose :global(em) { font-style: italic; }
  .prose :global(code) { background: var(--surface); padding: 0.1em 0.35em; border-radius: 3px; font-size: 0.875em; font-family: monospace; }
  .block-image { margin: 1.25rem 0; }
  .block-image img { border-radius: 4px; max-width: 100%; }
  .block-video {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    margin: 1.5rem 0;
    border-radius: 6px;
    background: #000;
  }
  .block-video iframe {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    border: 0;
  }
  .block-table { margin: 1.25rem 0; overflow-x: auto; }
  .block-table table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
  .block-table th { background: var(--surface); font-weight: 700; text-align: left; padding: 0.45rem 0.75rem; border: 1px solid var(--border); color: var(--amarillo); }
  .block-table td { padding: 0.4rem 0.75rem; border: 1px solid var(--border); }
  .block-table tbody tr:nth-child(even) td { background: var(--surface); }
</style>
